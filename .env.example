# Copy to .env and fill in. Never commit .env.
PUBLIC_BASE_URL=https://yt-api.example.com
ADMIN_TOKEN=change-me-to-a-long-random-string
# ── Google login (Clerk): one API key per real Google/Gmail account ──
CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
# The page origin(s) users sign in from (the public URL of this API)
CLERK_AUTHORIZED_PARTIES=https://yt-api.example.com
REQUIRE_GMAIL=true

# ── Network hardening ──
# Cloudflare Tunnel in docker-compose: the peer is the docker network.
# Leave the next four commented out on Railway/Render/Koyeb (VPS + Cloudflare only):
#TRUSTED_PROXIES=127.0.0.1/32
# Railway/Render/Koyeb: set PROXY_HOPS=1 so each visitor gets their own IP limits.
PROXY_HOPS=1
# Plain VPS behind the orange-cloud Cloudflare proxy: TRUST_CLOUDFLARE=true instead.
#TRUST_CLOUDFLARE=false
# Refuse anything that did not come through Cloudflare / the tunnel:
#REQUIRE_TRUSTED_PROXY=true
#ALLOWED_HOSTS=yt-api.example.com
# Optional: only your own IP may open /admin
ADMIN_IP_ALLOWLIST=
EXPOSE_DOCS=false
TUNNEL_TOKEN=

# Optional server-side issuing: your own bot may create keys without Google login.
# Only your bot should create keys? Set a secret and send it as X-Creation-Secret.
KEY_CREATION_SECRET=
ALLOW_PUBLIC_KEY_CREATION=true

# Payments (FamPay)
UPI_ID=yourname@fam
PAYEE_NAME=Madara Defaulter
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_PASSWORD=gmail-app-password
PAYMENT_SENDERS=fampay.in,famapp.in

# Optional yt-dlp tuning
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
